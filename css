
:root{
      --bg:#fff9f2;
      --card:#ffffff;
      --text:#2f2934;
      --muted:#7d7484;
      --purple:#7b4bb7;
      --purple2:#9b68d2;
      --purple3:#c9afe8;
      --green:#5f9f55;
      --line:#ece4f2;
      --gold:#f2b134;
      --danger:#d35f67;
      --shadow:0 12px 30px rgba(87,56,112,.12);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:"Pretendard","Noto Sans KR",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:
        radial-gradient(circle at top left, #f7ebff 0, transparent 36%),
        radial-gradient(circle at bottom right, #fff0cf 0, transparent 38%),
        var(--bg);
      color:var(--text);
      min-height:100vh;
    }
    button,input,select{font:inherit}
    button{cursor:pointer}
    .app{max-width:860px;margin:0 auto;padding:22px 16px 48px}
    .hero{
      background:linear-gradient(135deg,#6f3ca7,#9d65d7);
      color:#fff;border-radius:28px;padding:22px 22px 20px;
      box-shadow:var(--shadow);position:relative;overflow:hidden
    }
    .hero:after{
      content:"";position:absolute;width:220px;height:220px;border-radius:50%;
      background:rgba(255,255,255,.08);right:-70px;top:-90px
    }
    .hero-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;position:relative;z-index:1}
    .eyebrow{font-size:13px;opacity:.84;margin-bottom:6px}
    h1{font-size:27px;line-height:1.25;margin:0;font-weight:800}
    .date{margin-top:10px;font-size:14px;opacity:.9}
    .gear{
      border:0;background:rgba(255,255,255,.16);color:#fff;width:42px;height:42px;
      border-radius:14px;font-size:20px
    }
    .progress-wrap{margin-top:18px;position:relative;z-index:1}
    .progress-meta{display:flex;justify-content:space-between;font-size:14px;margin-bottom:8px}
    .progress{height:12px;background:rgba(255,255,255,.2);border-radius:999px;overflow:hidden}
    .bar{height:100%;width:0;background:#fff;border-radius:999px;transition:.35s ease}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}
    .card{
      background:rgba(255,255,255,.94);border:1px solid rgba(255,255,255,.8);
      border-radius:24px;padding:20px;box-shadow:var(--shadow)
    }
    .card h2{font-size:18px;margin:0 0 14px}
    .grape-stage{display:flex;align-items:center;justify-content:center;min-height:320px;position:relative}
    .grape-cluster{position:relative;width:250px;height:290px}
    .stem{
      position:absolute;width:14px;height:74px;background:#7b5b35;border-radius:999px;
      top:4px;left:121px;transform:rotate(8deg)
    }
    .leaf{
      position:absolute;width:74px;height:46px;background:var(--green);border-radius:70% 20% 70% 20%;
      top:20px;left:138px;transform:rotate(18deg);box-shadow:inset 0 -8px 0 rgba(0,0,0,.05)
    }
    .leaf:after{
      content:"";position:absolute;width:48px;height:3px;background:rgba(255,255,255,.35);
      left:10px;top:24px;transform:rotate(-18deg);border-radius:999px
    }
    .grape{
      position:absolute;width:58px;height:58px;border-radius:50%;
      background:#ddd4e4;border:3px solid #eee7f3;
      box-shadow:inset 0 -8px 0 rgba(0,0,0,.04),0 5px 10px rgba(70,45,90,.12);
      transition:.25s ease;display:flex;align-items:center;justify-content:center;
      font-size:20px;color:white;font-weight:800
    }
    .grape.done{
      background:linear-gradient(145deg,var(--purple2),var(--purple));
      border-color:#b995dc;transform:scale(1.04)
    }
    .grape.gold{
      background:linear-gradient(145deg,#ffd66d,#eaa820);
      border-color:#ffe6a7
    }
    .g1{top:70px;left:98px}.g2{top:105px;left:58px}.g3{top:105px;left:138px}
    .g4{top:145px;left:28px}.g5{top:145px;left:98px}.g6{top:145px;left:168px}
    .g7{top:190px;left:62px}.g8{top:190px;left:134px}.g9{top:235px;left:98px}
    .cheer{
      text-align:center;font-weight:800;color:var(--purple);margin-top:-8px;min-height:26px
    }
    .task-list{display:flex;flex-direction:column;gap:10px}
    .task{
      display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;
      padding:13px 14px;border:1px solid var(--line);border-radius:16px;background:#fff
    }
    .task.done{background:#faf7fd}
    .check{
      width:28px;height:28px;border-radius:9px;border:2px solid #cbb8dd;background:#fff;
      display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900
    }
    .task.done .check{background:var(--purple);border-color:var(--purple)}
    .task-text{font-weight:700}
    .task.done .task-text{text-decoration:line-through;color:var(--muted)}
    .task-icon{font-size:22px}
    .empty{padding:28px 10px;text-align:center;color:var(--muted);line-height:1.6}
    .actions{display:flex;gap:10px;margin-top:15px;flex-wrap:wrap}
    .btn{
      border:0;border-radius:14px;padding:11px 15px;font-weight:800
    }
    .btn-primary{background:var(--purple);color:#fff}
    .btn-soft{background:#f1e8f8;color:var(--purple)}
    .btn-danger{background:#fff0f1;color:var(--danger)}
    .week{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
    .day{
      text-align:center;padding:10px 4px;border-radius:14px;background:#f7f2fa;
      border:1px solid var(--line);font-size:12px;color:var(--muted)
    }
    .day strong{display:block;font-size:20px;margin-top:5px;color:#c8b9d2}
    .day.complete{background:#efe3fa;color:var(--purple)}
    .day.complete strong{color:var(--purple)}
    .wide{grid-column:1/-1}
    dialog{
      width:min(92vw,560px);border:0;border-radius:24px;padding:0;box-shadow:0 25px 80px rgba(0,0,0,.25)
    }
    dialog::backdrop{background:rgba(33,21,42,.45);backdrop-filter:blur(3px)}
    .modal{padding:22px}
    .modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
    .modal h3{margin:0;font-size:21px}
    .close{border:0;background:#f3eef6;border-radius:12px;width:38px;height:38px}
    .form-row{display:grid;grid-template-columns:84px 1fr auto;gap:10px;margin-bottom:10px}
    input,select{
      width:100%;padding:11px 12px;border:1px solid #dcd2e3;border-radius:12px;background:#fff
    }
    .icon-select{font-size:20px;text-align:center}
    .mini-del{border:0;background:#fff0f1;color:var(--danger);border-radius:12px;padding:0 12px}
    .modal-foot{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}

    .task-main{min-width:0}
    .task-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
    .badge{
      display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:999px;
      font-size:11px;font-weight:800;background:#f4eef8;color:var(--purple)
    }
    .badge.required{background:#fff1dc;color:#a56800}
    .badge.optional{background:#edf7ef;color:#3f7d46}
    .badge.point{background:#eef4ff;color:#486ea9}
    .editor-card{
      border:1px solid var(--line);border-radius:18px;padding:14px;margin-bottom:12px;background:#fff
    }
    .editor-grid{
      display:grid;grid-template-columns:86px 1fr;gap:10px;align-items:center;margin-top:10px
    }
    .editor-grid label{font-size:13px;font-weight:800;color:var(--muted)}
    .editor-actions{display:flex;justify-content:flex-end;margin-top:10px}
    .required-check{display:flex;align-items:center;gap:8px}
    .required-check input{width:auto}
    .score-summary{
      margin-top:14px;padding:12px 14px;border-radius:16px;background:#f7f2fa;
      color:var(--purple);font-weight:800;text-align:center
    }

    .view{display:none}
    .view.active{display:block}
    .bottom-nav{
      position:sticky;bottom:12px;z-index:15;margin:18px auto 0;
      display:grid;grid-template-columns:1fr 1fr;gap:10px;
      max-width:430px;padding:8px;background:rgba(255,255,255,.92);
      border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);
      backdrop-filter:blur(10px)
    }
    .nav-btn{
      border:0;border-radius:15px;padding:12px 10px;background:transparent;
      color:var(--muted);font-weight:900
    }
    .nav-btn.active{background:var(--purple);color:#fff}
    .farm-hero{
      background:linear-gradient(180deg,#bfe7ff 0 42%,#dff2b9 42% 100%);
      border-radius:28px;padding:18px;box-shadow:var(--shadow);overflow:hidden;position:relative;
      min-height:430px
    }
    .farm-sky{position:absolute;inset:0 0 auto 0;height:42%}
    .sun{
      position:absolute;right:28px;top:24px;width:66px;height:66px;border-radius:50%;
      background:#ffd85b;box-shadow:0 0 0 12px rgba(255,216,91,.18)
    }
    .cloud{position:absolute;font-size:50px;filter:drop-shadow(0 5px 8px rgba(0,0,0,.08))}
    .cloud.c1{left:24px;top:18px}.cloud.c2{left:130px;top:72px;font-size:38px}
    .farm-title{position:relative;z-index:2;text-align:center;margin:6px 0 4px;font-size:24px}
    .farm-sub{position:relative;z-index:2;text-align:center;color:#5f6a73;font-weight:700}
    .farm-scene{
      position:relative;z-index:2;min-height:315px;margin-top:12px;
      display:flex;align-items:flex-end;justify-content:center
    }
    .vine{
      position:relative;width:300px;height:280px;transform-origin:bottom center;
      transition:.4s ease
    }
    .trunk{
      position:absolute;bottom:18px;left:140px;width:24px;height:150px;
      background:linear-gradient(90deg,#6f482a,#9b7044,#70482a);
      border-radius:16px 16px 9px 9px;z-index:2
    }
    .branch{
      position:absolute;height:13px;background:#795333;border-radius:999px;z-index:1
    }
    .branch.b1{
      width:118px;left:151px;bottom:142px;
      transform:rotate(-24deg);transform-origin:left center
    }
    .branch.b2{
      width:118px;left:33px;bottom:142px;
      transform:rotate(24deg);transform-origin:right center
    }
    .branch.b3{
      width:92px;left:151px;bottom:104px;
      transform:rotate(18deg);transform-origin:left center
    }
    .branch.b4{
      width:92px;left:59px;bottom:104px;
      transform:rotate(-18deg);transform-origin:right center
    }
    .farm-leaf{
      position:absolute;width:64px;height:43px;background:#64a857;
      border-radius:72% 22% 72% 22%;
      box-shadow:inset 0 -6px rgba(0,0,0,.05);
      z-index:3
    }
    .farm-leaf.l1{left:24px;bottom:157px;transform:rotate(-18deg)}
    .farm-leaf.l2{left:76px;bottom:202px;transform:rotate(20deg)}
    .farm-leaf.l3{left:166px;bottom:210px;transform:rotate(-18deg)}
    .farm-leaf.l4{left:222px;bottom:158px;transform:rotate(22deg)}
    .farm-leaf.l5{left:72px;bottom:103px;transform:rotate(12deg)}
    .farm-leaf.l6{left:186px;bottom:105px;transform:rotate(-16deg)}
    .farm-leaf.l7{left:119px;bottom:226px;transform:rotate(44deg)}
    .farm-leaf.l8{left:119px;bottom:144px;transform:rotate(-42deg)}
    .bunch{
      position:absolute;font-size:46px;filter:drop-shadow(0 6px 8px rgba(72,40,92,.18));
      animation:bob 2.4s ease-in-out infinite
    }
    .bunch.p1{left:65px;bottom:125px}.bunch.p2{left:185px;bottom:128px;animation-delay:.3s}
    .bunch.p3{left:117px;bottom:72px;animation-delay:.6s}
    .farm-ground{
      position:absolute;left:0;right:0;bottom:0;height:58px;
      background:linear-gradient(#8acb65,#69ad4c)
    }
    .farm-deco{position:absolute;bottom:18px;font-size:34px;z-index:3}
    .farm-deco.d1{left:24px}.farm-deco.d2{right:30px}.farm-deco.d3{right:90px;font-size:27px}
    @keyframes bob{50%{transform:translateY(-5px)}}
    .farm-stats{
      display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px
    }
    .stat{
      background:#fff;border:1px solid var(--line);border-radius:18px;padding:14px;
      text-align:center;box-shadow:var(--shadow)
    }
    .stat strong{display:block;font-size:24px;color:var(--purple);margin-top:4px}
    .milestone{margin-top:16px}
    .milestone-row{
      display:flex;justify-content:space-between;align-items:center;gap:12px;
      padding:14px;border:1px solid var(--line);border-radius:16px;background:#fff
    }
    .level-badge{
      display:inline-block;padding:6px 10px;border-radius:999px;
      background:#efe3fa;color:var(--purple);font-weight:900;font-size:12px
    }
    .farm-progress{height:12px;background:#eee6f3;border-radius:999px;overflow:hidden;margin-top:10px}
    .farm-progress-bar{height:100%;background:linear-gradient(90deg,var(--purple2),var(--purple));width:0}
    @media(max-width:700px){
      .farm-stats{grid-template-columns:1fr 1fr 1fr}
      .farm-hero{min-height:405px}
      .vine{transform:scale(.9)}
    }

    .village-wrap{
      position:relative;min-height:520px;overflow:hidden;border-radius:28px;
      background:linear-gradient(180deg,#bfe8ff 0 45%,#cdeca5 45% 100%);
      box-shadow:var(--shadow);padding:18px
    }
    .village-title{position:relative;z-index:4;text-align:center;margin:4px 0;font-size:24px}
    .village-sub{position:relative;z-index:4;text-align:center;color:#5f6a73;font-weight:700}
    .village-sun{
      position:absolute;right:28px;top:28px;width:64px;height:64px;border-radius:50%;
      background:#ffd85b;box-shadow:0 0 0 12px rgba(255,216,91,.18)
    }
    .village-cloud{position:absolute;font-size:48px;opacity:.9}
    .village-cloud.c1{left:22px;top:34px}
    .village-cloud.c2{left:135px;top:86px;font-size:35px}
    .hill{
      position:absolute;border-radius:50% 50% 0 0;background:#93cf6c;bottom:0
    }
    .hill.h1{width:390px;height:175px;left:-85px}
    .hill.h2{width:380px;height:150px;right:-100px;background:#7fbe5c}
    .road{
      position:absolute;left:50%;bottom:-70px;width:120px;height:390px;
      background:#e7d2a1;transform:translateX(-50%) perspective(300px) rotateX(45deg);
      border-left:7px solid rgba(255,255,255,.35);border-right:7px solid rgba(255,255,255,.35)
    }
    .village-grid{
      position:relative;z-index:3;display:grid;grid-template-columns:repeat(2,1fr);
      gap:16px;margin-top:62px;padding-bottom:22px
    }
    .shop-building{
      border:0;background:transparent;padding:0;cursor:pointer;text-align:center;
      transition:transform .18s ease
    }
    .shop-building:hover{transform:translateY(-4px)}
    .shop-building:active{transform:scale(.98)}
    .building{
      position:relative;margin:auto;width:150px;height:135px;
      filter:drop-shadow(0 9px 8px rgba(65,76,43,.18))
    }
    .roof{
      position:absolute;left:14px;top:10px;width:122px;height:62px;
      clip-path:polygon(50% 0,100% 100%,0 100%);
      background:#9d5c4c;z-index:3
    }
    .building-body{
      position:absolute;left:23px;bottom:5px;width:104px;height:88px;
      border-radius:9px 9px 5px 5px;background:#fff6dc;border:4px solid rgba(97,72,52,.18)
    }
    .awning{
      position:absolute;left:34px;top:67px;width:82px;height:22px;z-index:4;
      border-radius:5px;background:repeating-linear-gradient(90deg,#fff 0 14px,#ef7e8d 14px 28px)
    }
    .shop-window{
      position:absolute;left:38px;bottom:18px;width:40px;height:42px;
      border-radius:5px;background:#bde8f4;border:4px solid #8b684e
    }
    .shop-door{
      position:absolute;right:34px;bottom:8px;width:29px;height:52px;
      border-radius:5px 5px 0 0;background:#9b7044
    }
    .building-icon{
      position:absolute;z-index:5;left:50%;top:37px;transform:translateX(-50%);
      font-size:35px
    }
    .shop-label{
      display:inline-block;margin-top:4px;padding:7px 12px;border-radius:999px;
      background:rgba(255,255,255,.92);font-weight:900;color:var(--purple);
      border:1px solid rgba(83,55,103,.1)
    }
    .shop-building[data-shop="book"] .roof{background:#547f9f}
    .shop-building[data-shop="gift"] .roof{background:#8b65a8}
    .shop-building[data-shop="play"] .roof{background:#e39a3a}
    .shop-building[data-shop="book"] .awning{
      background:repeating-linear-gradient(90deg,#fff 0 14px,#78a6c7 14px 28px)
    }
    .shop-building[data-shop="gift"] .awning{
      background:repeating-linear-gradient(90deg,#fff 0 14px,#b08ac7 14px 28px)
    }
    .shop-building[data-shop="play"] .awning{
      background:repeating-linear-gradient(90deg,#fff 0 14px,#f0b765 14px 28px)
    }
    .village-npc{
      position:absolute;z-index:5;top:110px;right:18px;font-size:42px;
      animation:npcBob 2.2s ease-in-out infinite
    }
    .npc-bubble{
      position:absolute;z-index:5;right:70px;top:110px;max-width:180px;
      background:#fff;border-radius:16px;padding:9px 12px;font-size:13px;font-weight:800;
      box-shadow:0 5px 15px rgba(0,0,0,.1)
    }
    .npc-bubble:after{
      content:"";position:absolute;right:-8px;top:18px;border-width:7px 0 7px 9px;
      border-style:solid;border-color:transparent transparent transparent #fff
    }
    @keyframes npcBob{50%{transform:translateY(-5px)}}

    .shop-sheet{
      width:min(520px,calc(100% - 26px));max-height:82vh;border:0;border-radius:24px;
      padding:0;box-shadow:0 24px 70px rgba(0,0,0,.25)
    }
    .shop-sheet::backdrop{background:rgba(38,25,47,.48)}
    .shop-sheet-head{
      display:flex;justify-content:space-between;align-items:center;padding:18px;
      border-bottom:1px solid var(--line);background:#faf7fc
    }
    .shop-sheet-head h2{margin:0}
    .shop-balance{
      margin:14px 16px;padding:12px 14px;border-radius:16px;background:#f4ecfa;
      font-weight:900;color:var(--purple);text-align:center
    }
    .shop-items{padding:0 16px 18px}
    .shop-item{
      display:grid;grid-template-columns:50px 1fr auto;gap:12px;align-items:center;
      padding:13px 0;border-bottom:1px solid var(--line)
    }
    .shop-item:last-child{border-bottom:0}
    .shop-item-icon{font-size:38px;text-align:center}
    .shop-item-name{font-weight:900}
    .shop-item-price{font-size:13px;color:var(--muted);margin-top:3px}
    .buy-btn{
      border:0;border-radius:12px;padding:9px 11px;background:var(--purple);color:#fff;
      font-weight:900
    }
    .buy-btn:disabled{background:#cfc4d6;cursor:not-allowed}
    .village-note{
      margin-top:16px;padding:14px;border-radius:18px;background:#fff;
      border:1px solid var(--line);font-size:14px;color:var(--muted)
    }
    @media(max-width:480px){
      .village-grid{gap:8px;margin-top:70px}
      .building{transform:scale(.88)}
      .shop-label{margin-top:-4px}
      .village-npc{top:100px;right:10px;font-size:34px}
      .npc-bubble{
        top:100px;right:46px;max-width:135px;font-size:11px;
        padding:8px 10px
      }
    }


    .mom-lock,.mom-dashboard{max-width:760px;margin:0 auto}
    .mom-lock-card{
      background:linear-gradient(145deg,#fff,#f7f0fb);border:1px solid var(--line);
      border-radius:28px;padding:28px 22px;text-align:center;box-shadow:var(--shadow)
    }
    .mom-lock-icon{font-size:58px;margin-bottom:8px}
    .mom-lock-card h2{margin:4px 0 8px;color:var(--purple)}
    .mom-lock-card p{margin:0 auto 18px;max-width:430px;color:var(--muted);line-height:1.6}
    .mom-password-row{display:flex;gap:10px;max-width:360px;margin:auto}
    .mom-password-row input{flex:1;text-align:center;font-size:20px;letter-spacing:7px}
    .mom-error{min-height:22px;color:var(--danger);font-size:14px;font-weight:800;margin-top:8px}

    .mom-head{
      display:flex;justify-content:space-between;align-items:center;gap:12px;
      margin-bottom:16px
    }
    .mom-head h2{margin:0;color:var(--purple)}
    .mom-actions{display:flex;gap:8px;flex-wrap:wrap}
    .mom-metrics{
      display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px
    }
    .mom-metric{
      background:#fff;border:1px solid var(--line);border-radius:18px;padding:15px;
      text-align:center;box-shadow:0 6px 18px rgba(67,43,80,.06)
    }
    .mom-metric .emoji{font-size:25px}
    .mom-metric strong{display:block;font-size:21px;color:var(--purple);margin-top:5px}
    .mom-metric span{font-size:12px;color:var(--muted);font-weight:800}
    .mom-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .mom-panel{
      background:#fff;border:1px solid var(--line);border-radius:22px;padding:17px;
      box-shadow:0 7px 20px rgba(67,43,80,.06)
    }
    .mom-panel.wide{grid-column:1/-1}
    .mom-panel h3{margin:0 0 13px;color:var(--purple)}
    .today-progress{
      height:12px;background:#eee7f2;border-radius:999px;overflow:hidden;margin:10px 0 6px
    }
    .today-progress > div{height:100%;background:var(--purple);border-radius:inherit;transition:.3s}
    .category-stat{margin:12px 0}
    .category-stat-head{display:flex;justify-content:space-between;font-size:13px;font-weight:900}
    .category-bar{height:9px;background:#eee7f2;border-radius:999px;overflow:hidden;margin-top:6px}
    .category-bar div{height:100%;background:var(--purple);border-radius:inherit}
    .mom-list{display:grid;gap:8px}
    .mom-list-item{
      display:flex;justify-content:space-between;align-items:center;gap:10px;
      padding:10px 11px;border-radius:14px;background:#faf7fc;border:1px solid #eee6f2
    }
    .mom-list-main{min-width:0}
    .mom-list-main strong{display:block}
    .mom-list-main small{color:var(--muted)}
    .empty-state{text-align:center;color:var(--muted);padding:20px 8px}
    .point-control{display:grid;grid-template-columns:1fr 100px auto;gap:8px}
    .point-control input{min-width:0}
    .shop-admin-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}
    .shop-admin-tab{
      border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 11px;
      font-weight:900;color:var(--muted)
    }
    .shop-admin-tab.active{background:var(--purple);color:#fff;border-color:var(--purple)}
    .shop-admin-item{
      display:grid;grid-template-columns:62px 1fr 90px auto;gap:8px;align-items:center;
      margin-bottom:9px;padding:10px;border:1px solid var(--line);border-radius:15px
    }
    .shop-admin-item input{min-width:0}
    .mom-note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:9px}
    @media(max-width:650px){
      .mom-metrics{grid-template-columns:repeat(2,1fr)}
      .mom-grid{grid-template-columns:1fr}
      .mom-panel.wide{grid-column:auto}
      .mom-password-row{flex-direction:column}
      .point-control{grid-template-columns:1fr 90px}
      .point-control button{grid-column:1/-1}
      .shop-admin-item{grid-template-columns:48px 1fr 76px}
      .shop-admin-item .mini-del{grid-column:1/-1}
    }

    .toast{
      position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);
      background:#2e2533;color:#fff;padding:12px 18px;border-radius:999px;
      opacity:0;pointer-events:none;transition:.25s;z-index:20
    }
    .toast.show{opacity:1;transform:translate(-50%,0)}
    .confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:30}
    .piece{position:absolute;top:-20px;width:10px;height:16px;border-radius:3px;animation:fall 1.8s linear forwards}
    @keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.85}}
    @media(max-width:700px){
      .grid{grid-template-columns:1fr}
      .grape-stage{min-height:300px}
      .card{padding:17px}
      h1{font-size:24px}
      .week{gap:5px}
      .day{padding:9px 2px}
      .form-row{grid-template-columns:72px 1fr auto}
    }
